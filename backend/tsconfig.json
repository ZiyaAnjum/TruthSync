{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "zod": ["./node_modules/zod"],
      "@anthropic-ai/sdk": ["./node_modules/@anthropic-ai/sdk"]
    }
  },
  "include": ["src/**/*", "prompts/**/*"]
}

