# TruthSync Backend Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control or expose API keys.

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration (Allowed frontend origin for local development or production)
FRONTEND_URL=http://localhost:5173

# Live Web Evidence Search (Tavily API)
TAVILY_API_KEY=

# Database & Storage (Supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
